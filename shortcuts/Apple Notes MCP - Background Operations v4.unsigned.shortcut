			<key>WFWorkflowActionParameters</key>
			<dict>
				<key>UUID</key>
				<string>4B23A5E3-667C-5B83-B36D-4941C64B2279</string>
				<key>WFCommentActionText</key>
				<string>Background Notes MCP bridge v4. Explicit legacy append inputs; native create actions have OpenWhenRun disabled; pin operations use fixed enum values. Exact title and literal body scope checked after unique search. MCP validates IDs, revisions and readback. No UI actions, database writes, shell scripts, network or arbitrary action execution.</string>
